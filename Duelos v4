--// Verificar si es enemigo
local function IsEnemy(player)
    if not Config.Aimbot.TeamCheck then return true end
    if not player.Team or not LocalPlayer.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

--// Obtener enemigos
local function GetEnemies()
    local enemies = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsEnemy(player) then
            table.insert(enemies, player)
        end
    end
    return enemies
end

--// Obtener objetivo mÃ¡s cercano al centro de la pantalla (mejor para mÃ³vil)
local function GetClosestToCenter()
    local closestPlayer = nil
    local shortestDistance = Config.Aimbot.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in pairs(GetEnemies()) do
        local character = player.Character
        if not character then continue end
        
        local targetPart = character:FindFirstChild(Config.Aimbot.TargetPart)
        if not targetPart then continue end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
        
        if distance < shortestDistance then
            closestPlayer = player
            shortestDistance = distance
        end
    end
    
    return closestPlayer
end

--// FunciÃ³n de Aimbot suavizado
local function RunAimbot()
    if not Config.Aimbot.Enabled then return end
    
    local target = GetClosestToCenter()
    if target and target.Character then
        local targetPart = target.Character:FindFirstChild(Config.Aimbot.TargetPart)
        if targetPart then
            local targetPos = Camera:WorldToViewportPoint(targetPart.Position)
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            
            local delta = Vector2.new(targetPos.X - screenCenter.X, targetPos.Y - screenCenter.Y)
            
            -- Suavizado exponencial
            local smooth = Config.Aimbot.Smoothness
            local moveX = delta.X * smooth
            local moveY = delta.Y * smooth
            
            -- Mover cÃ¡mara
            Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.Angles(0, -math.rad(moveX * 0.1), 0)
            Camera.CFrame = Camera.CFrame * CFrame.Angles(-math.rad(moveY * 0.1), 0, 0)
        end
    end
end

--// ESP para mÃ³vil (optimizado)
local function CreateESP(player)
    if ESPObjects[player] then return end
    
    local esp = {
        Player = player,
        Elements = {},
        Connection = nil
    }
    
    -- Crear elementos visuales
    local nameTag = Instance.new("TextLabel")
    nameTag.Size = UDim2.new(0, 150, 0, 18)
    nameTag.BackgroundTransparency = 1
    nameTag.TextColor3 = Config.ESP.EnemyColor
    nameTag.TextSize = Config.ESP.TextSize
    nameTag.Font = Enum.Font.GothamBold
    nameTag.TextStrokeTransparency = 0.3
    nameTag.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameTag.Parent = ScreenGui
    
    local distTag = Instance.new("TextLabel")
    distTag.Size = UDim2.new(0, 150, 0, 14)
    distTag.BackgroundTransparency = 1
    distTag.TextColor3 = Color3.fromRGB(200, 200, 200)
    distTag.TextSize = Config.ESP.TextSize - 1
    distTag.Font = Enum.Font.Gotham
    distTag.TextStrokeTransparency = 0.3
    distTag.TextStrokeColor3 = Color3.new(0, 0, 0)
    distTag.Parent = ScreenGui
    
    local healthTag = Instance.new("TextLabel")
    healthTag.Size = UDim2.new(0, 150, 0, 14)
    healthTag.BackgroundTransparency = 1
    healthTag.TextColor3 = Color3.fromRGB(50, 255, 50)
    healthTag.TextSize = Config.ESP.TextSize - 1
    healthTag.Font = Enum.Font.Gotham
    healthTag.TextStrokeTransparency = 0.3
    healthTag.TextStrokeColor3 = Color3.new(0, 0, 0)
    healthTag.Parent = ScreenGui
    
    esp.Elements.Name = nameTag
    esp.Elements.Distance = distTag
    esp.Elements.Health = healthTag
    
    -- Actualizar loop
    esp.Connection = RunService.RenderStepped:Connect(function()
        if not Config.ESP.Enabled then
            nameTag.Visible = false
            distTag.Visible = false
            healthTag.Visible = false
            return
        end
        
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            nameTag.Visible = false
            distTag.Visible = false
            healthTag.Visible = false
            return
        end
        
        -- Team check
        if Config.ESP.TeamCheck and not IsEnemy(player) then
            nameTag.Visible = false
            distTag.Visible = false
            healthTag.Visible = false
            return
        end
        
        local hrp = player.Character.HumanoidRootPart
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
        
        if not onScreen then
            nameTag.Visible = false
            distTag.Visible = false
            healthTag.Visible = false
            return
        end
        
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local distance = myHRP and (myHRP.Position - hrp.Position).Magnitude or 0
        
        if distance > Config.ESP.MaxDistance then
            nameTag.Visible = false
            distTag.Visible = false
            healthTag.Visible = false
            return
        end
        
        -- Actualizar posiciones
        nameTag.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 45)
        nameTag.Text = player.Name
        nameTag.Visible = Config.ESP.ShowName
        
        distTag.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 30)
        distTag.Text = math.floor(distance) .. "m"
        distTag.Visible = Config.ESP.ShowDistance
        
        if humanoid then
            healthTag.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 15)
            healthTag.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
            healthTag.Visible = Config.ESP.ShowHealth
        end
    end)
    
    ESPObjects[player] = esp
end

--// Limpiar ESP
local function RemoveESP(player)
    local esp = ESPObjects[player]
    if esp then
        if esp.Connection then esp.Connection:Disconnect() end
        for _, element in pairs(esp.Elements) do
            if element then element:Destroy() end
        end
        ESPObjects[player] = nil
    end
end

--// Inicializar ESP
local function InitESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
        end
    end
end

--// Eventos
Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        CreateESP(player)
    end
end)

Players.PlayerRemoving:Connect(RemoveESP)

--// Main Loop
RunService.RenderStepped:Connect(function()
    RunAimbot()
end)

