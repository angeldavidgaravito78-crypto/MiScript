    stroke.Color = Colors.Primary
    stroke.Thickness = 1
    stroke.Parent = frame
    
    -- Animación de entrada
    frame.Position = UDim2.new(1, 20, 1, -70)
    TweenService:Create(frame, TweenInfo.new(0.3), {
        Position = UDim2.new(1, -260, 1, -70)
    }):Play()
    
    task.delay(duration or 3, function()
        local outTween = TweenService:Create(frame, TweenInfo.new(0.3), {
            Position = UDim2.new(1, 20, 1, -70)
        })
        outTween:Play()
        outTween.Completed:Wait()
        notifGui:Destroy()
    end)
end

--// SISTEMA ANTI-AFK
if Config.AntiAFK then
    local afkConnection = nil
    local lastMove = tick()
    
    afkConnection = UserInputService.InputBegan:Connect(function()
        lastMove = tick()
    end)
    
    task.spawn(function()
        while Config.AntiAFK do
            task.wait(30)
            if tick() - lastMove > 30 then
                -- Simular movimiento mínimo
                if Humanoid then
                    Humanoid:Move(Vector3.new(0.1, 0, 0.1), false)
                    task.wait(0.1)
                    Humanoid:Move(Vector3.new(-0.1, 0, -0.1), false)
                end
            end
        end
    end)
end

--// SISTEMA DE DETECCIÓN DE HUEVOS
local function IsEgg(obj)
    local name = obj.Name:lower()
    return name:find("egg") or 
           name:find("huevo") or 
           name:find("easter") or
           name:find("collectible") or
           (obj:IsA("BasePart") and obj:FindFirstChildWhichIsA("TouchInterest"))
end

local function ScanForEggs()
    Eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsEgg(obj) and obj:IsA("BasePart") then
            local distance = (HumanoidRootPart.Position - obj.Position).Magnitude
            if distance <= Config.MaxDistance then
                table.insert(Eggs, {
                    Object = obj,
                    Distance = distance,
                    Position = obj.Position
                })
            end
        end
    end
    
    -- Ordenar según prioridad
    if Config.Priority == "Closest" then
        table.sort(Eggs, function(a, b) return a.Distance < b.Distance end)
    elseif Config.Priority == "Farthest" then
        table.sort(Eggs, function(a, b) return a.Distance > b.Distance end)
    end
    
    return Eggs
end

--// SISTEMA ESP
local function CreateESP(egg)
    if ESPObjects[egg.Object] then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggESP"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = egg.Object
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Colors.Primary
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = billboard
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -4, 1, -4)
    label.Position = UDim2.new(0, 2, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = "🥚 " .. egg.Object.Name .. "\n" .. math.floor(egg.Distance) .. "m"
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.Parent = frame
    
    ESPObjects[egg.Object] = billboard
    
    -- Actualizar distancia
    task.spawn(function()
        while ESPObjects[egg.Object] and egg.Object.Parent do
            task.wait(0.5)
            if HumanoidRootPart and egg.Object then
                local dist = (HumanoidRootPart.Position - egg.Object.Position).Magnitude
                label.Text = "🥚 " .. egg.Object.Name .. "\n" .. math.floor(dist) .. "m"
            end
        end
    end)
end

local function ClearESP()
    for obj, esp in pairs(ESPObjects) do
        if esp then esp:Destroy() end
    end
    ESPObjects = {}
end

local function UpdateESP()
    if not Config.ESP then
        ClearESP()
        return
    end
    
    ScanForEggs()
    for _, egg in ipairs(Eggs) do
        CreateESP(egg)
    end
end

--// SISTEMA DE ROBO
local function StealEgg(egg)
    if not egg or not egg.Object or not egg.Object.Parent then return false end
    
    local targetPosition = egg.Object.Position + Vector3.new(0, 3, 0)
    
    if Config.StealMethod == "Tween" then
        local tween = TweenService:Create(
            HumanoidRootPart,
            TweenInfo.new(Config.StealSpeed / 1000, Enum.EasingStyle.Linear),
            {CFrame = CFrame.new(targetPosition)}
        )
        tween:Play()
        tween.Completed:Wait()
        
    elseif Config.StealMethod == "Teleport" then
        HumanoidRootPart.CFrame = CFrame.new(targetPosition)
        task.wait(0.1)
        
    elseif Config.StealMethod == "CFrame" then
        for i = 1, 10 do
            HumanoidRootPart.CFrame = HumanoidRootPart.CFrame:Lerp(CFrame.new(targetPosition), 0.3)
            task.wait(0.05)
        end
    end
    
    -- Intentar recolectar
    if egg.Object:FindFirstChildWhichIsA("TouchInterest") then
        firetouchinterest(HumanoidRootPart, egg.Object, 0)
        task.wait(0.05)
        firetouchinterest(HumanoidRootPart, egg.Object, 1)
    end
    
    -- Auto-click si está activado
    if Config.AutoClick then
        local clickDetector = egg.Object:FindFirstChildWhichIsA("ClickDetector")
        if clickDetector then
            fireclickdetector(clickDetector)
        end
    end
    
    Notify("Huevo Robado!", "Has recolectado: " .. egg.Object.Name, 2)
    return true
end

local function AutoStealLoop()
    while Config.AutoSteal do
        ScanForEggs()
        
        if #Eggs > 0 then
            local target = Config.Priority == "Random" and Eggs[math.random(1, #Eggs)] or Eggs[1]
            StealEgg(target)
            task.wait(Config.ClickDelay)
        else
            task.wait(1)
        end
    end
end

