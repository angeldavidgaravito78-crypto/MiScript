--// Optimizado para Android/Móvil

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

--// CONFIGURACIÓN
local Config = {
    AimbotEnabled = false,
    ESPenabled = false,
    TeamCheck = true,
    AimPart = "HumanoidRootPart",
    AimOffset = Vector3.new(0, 0.8, 0),
    Smoothness = 0.1,
    FOV = 200,
    WallCheck = false,
    ESPMaxDistance = 1000
}

--// VARIABLES
local CurrentTarget = nil
local ESPObjects = {}
local AimbotActive = false

--// FUNCIONES UTILITARIAS

local function IsPlayerValid(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    if not player.Character:FindFirstChild("Humanoid") then return false end
    if player.Character.Humanoid.Health <= 0 then return false end
    
    if Config.TeamCheck and player.Team == LocalPlayer.Team then
        return false
    end
    
    return true
end

local function GetAimPosition(character)
    local hrp = character:FindFirstChild(Config.AimPart)
    if hrp then
        return hrp.Position + Config.AimOffset
    end
    return nil
end

local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = Config.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if not IsPlayerValid(player) then continue end
        
        local aimPos = GetAimPosition(player.Character)
        if not aimPos then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then continue end
        
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if distance < shortestDistance then
            shortestDistance = distance
            closest = player
        end
    end
    
    return closest
end

--// SISTEMA ESP SIMPLE

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local esp = {
        Box = Instance.new("BillboardGui"),
        Name = Instance.new("TextLabel")
    }
    
    esp.Box.Name = "ESP_Box"
    esp.Box.AlwaysOnTop = true
    esp.Box.Size = UDim2.new(0, 100, 0, 100)
    esp.Box.StudsOffset = Vector3.new(0, 2, 0)
    esp.Box.Parent = player.Character and player.Character:FindFirstChild("HumanoidRootPart") or nil
    
    esp.Name.Parent = esp.Box
    esp.Name.Size = UDim2.new(1, 0, 0, 20)
    esp.Name.BackgroundTransparency = 1
    esp.Name.TextColor3 = Color3.fromRGB(255, 0, 0)
    esp.Name.TextStrokeTransparency = 0
    esp.Name.TextSize = 14
    esp.Name.Text = player.Name
    
    ESPObjects[player] = esp
    
    -- Actualizar posición
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            esp.Box.Enabled = false
            return
        end
        
        if not Config.ESPenabled then
            esp.Box.Enabled = false
            return
        end
        
        local distance = (Camera.CFrame.Position - player.Character.HumanoidRootPart.Position).Magnitude
        if distance > Config.ESPMaxDistance then
            esp.Box.Enabled = false
            return
        end
        
        esp.Box.Adornee = player.Character.HumanoidRootPart
        esp.Box.Enabled = true
        
        -- Color según equipo
        if player.Team == LocalPlayer.Team then
            esp.Name.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            esp.Name.TextColor3 = Color3.fromRGB(255, 0, 0)
        end
        
        esp.Name.Text = player.Name .. " [" .. math.floor(distance) .. "m]"
    end)
    
    player.AncestryChanged:Connect(function()
        if not player:IsDescendantOf(game) then
            connection:Disconnect()
            esp.Box:Destroy()
            ESPObjects[player] = nil
        end
    end)
end

