-- Función para crear botones de función
local function CreateFeatureButton(name, position, callback)
    local Button = Instance.new("TextButton")
    Button.Name = name
    Button.Size = UDim2.new(0, 160, 0, 45)
    Button.Position = position
    Button.BackgroundColor3 = Colors.Secondary
    Button.Text = name
    Button.TextColor3 = Colors.Text
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamSemibold
    Button.AutoButtonColor = false
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Colors.Accent
    Stroke.Thickness = 2
    Stroke.Transparency = 0.5
    Stroke.Parent = Button
    
    -- Efecto hover
    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Accent}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    end)
    
    Button.MouseLeave:Connect(function()
        if not States[name:gsub(" ", "")] then
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Secondary}):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
        end
    end)
    
    Button.MouseButton1Click:Connect(function()
        States[name:gsub(" ", "")] = not States[name:gsub(" ", "")]
        if States[name:gsub(" ", "")] then
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Success}):Play()
            Button.Text = name .. " ✓"
        else
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Secondary}):Play()
            Button.Text = name
        end
        if callback then callback(States[name:gsub(" ", "")]) end
    end)
    
    return Button
end

