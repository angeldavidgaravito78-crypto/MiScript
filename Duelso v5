--// DetecciÃ³n de sistema de equipos
local function GetPlayerTeam(player)
    -- MÃ©todo 1: Team nativo de Roblox
    if player.Team then
        return tostring(player.Team)
    end
    
    -- MÃ©todo 2: Atributo "Team"
    if player:GetAttribute("Team") then
        return tostring(player:GetAttribute("Team"))
    end
    
    -- MÃ©todo 3: Leaderstats
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local teamValue = leaderstats:FindFirstChild("Team") or leaderstats:FindFirstChild("team")
        if teamValue and teamValue:IsA("StringValue") then
            return teamValue.Value
        end
    end
    
    -- MÃ©todo 4: Valor en personaje
    if player.Character then
        local teamVal = player.Character:FindFirstChild("Team") or player.Character:FindFirstChild("team")
        if teamVal and teamVal:IsA("StringValue") then
            return teamVal.Value
        end
        
        -- MÃ©todo 5: Color del nombre (algunos juegos lo usan)
        if player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            if head:FindFirstChild("NameTag") or head:FindFirstChild("name") then
                local tag = head:FindFirstChild("NameTag") or head:FindFirstChild("name")
                if tag:IsA("TextLabel") or tag:IsA("BillboardGui") then
                    -- Extraer color si es necesario
                end
            end
        end
    end
    
    return nil
end

--// Verificar si es enemigo (MEJORADO)
local function IsEnemy(player)
    if not Config.Aimbot.TeamCheck then return true end
    if player == LocalPlayer then return false end
    
    local myTeam = GetPlayerTeam(LocalPlayer)
    local theirTeam = GetPlayerTeam(player)
    
    -- Si no hay informaciÃ³n de equipo, asumir enemigo
    if not myTeam or not theirTeam then
        return true
    end
    
    return myTeam ~= theirTeam
end

